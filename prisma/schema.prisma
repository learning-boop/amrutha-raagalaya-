// Amrutha Raagalaya — admin-managed content.
// Run `npx prisma migrate dev` after changing this file.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps connection URLs out of the schema: migrations read them from
// prisma.config.ts, and the runtime client gets a driver adapter (src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// The people who can sign in at /admin. Created with `npm run admin:create`.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A photo shown on /gallery. `publicId` is the Cloudinary handle, kept so the
/// image can be deleted from storage when the row is removed.
model GalleryImage {
  id        String   @id @default(cuid())
  category  String
  caption   String
  url       String
  publicId  String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category, sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  /// Sanitised HTML produced by the admin editor.
  content     String
  coverUrl    String?
  coverId     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

/// A time the teacher is free for a trial class, published by the admin.
model TrialSlot {
  id              String         @id @default(cuid())
  /// Stored in UTC; always entered and displayed as India time (IST).
  startsAt        DateTime
  durationMinutes Int            @default(30)
  /// "online" (Zoom) or "in-person" (at the academy).
  mode            String
  /// Zoom link sent to the parent on confirmation. Online slots only.
  meetingLink     String?
  /// How many children can take this slot. Usually 1.
  capacity        Int            @default(1)
  createdAt       DateTime       @default(now())
  bookings        TrialBooking[]

  @@index([startsAt])
}

/// A parent's request for a trial slot.
model TrialBooking {
  id         String    @id @default(cuid())
  slotId     String
  // Restrict: a slot holding bookings cannot be deleted, so a family's
  // request can never silently disappear.
  slot       TrialSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  parentName String
  /// WhatsApp number as digits with country code, e.g. 919876543210.
  phone      String
  childName  String
  childAge   Int
  notes      String?
  /// pending → confirmed | declined. Pending and confirmed both hold the seat.
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([slotId, status])
  @@index([status, createdAt])
  @@index([phone, status])
}

/// A message sent from the enquiry forms on /contact. Saved here rather than
/// handed off to WhatsApp, so nothing is lost if the visitor never opens it.
model Enquiry {
  id        String    @id @default(cuid())
  /// "classes" or "program".
  kind      String
  name      String
  /// WhatsApp number as digits with country code, e.g. 919876543210.
  phone     String
  /// Classes enquiries only.
  age       Int?
  /// Program enquiries only: occasion, date and venue as typed.
  occasion  String?
  eventDate String?
  location  String?
  message   String?
  /// new → handled. The admin marks it handled once they have replied.
  status    String    @default("new")
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@index([status, createdAt])
}

/// A Google review copied into the site by an admin, shown in the reviews
/// carousel. Google's API is not used, so these are entered by hand and the
/// carousel links to the Google listing for the full, live list.
model Review {
  id         String   @id @default(cuid())
  author     String
  /// Whole stars, 1–5.
  rating     Int      @default(5)
  text       String
  /// As Google shows it, e.g. "2 months ago" or "March 2026". Optional.
  reviewedOn String?
  published  Boolean  @default(true)
  /// Lower numbers show first; ties fall back to newest added.
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
}
