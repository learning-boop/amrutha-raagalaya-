// Amrutha Raagalaya — admin-managed content.
// Run `npx prisma migrate dev` after changing this file.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps connection URLs out of the schema: migrations read them from
// prisma.config.ts, and the runtime client gets a driver adapter (src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

/// The people who can sign in at /admin. Created with `npm run admin:create`.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A photo shown on /gallery. `publicId` is the Cloudinary handle, kept so the
/// image can be deleted from storage when the row is removed.
model GalleryImage {
  id        String   @id @default(cuid())
  category  String
  caption   String
  url       String
  publicId  String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category, sortOrder])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  /// Sanitised HTML produced by the admin editor.
  content     String
  coverUrl    String?
  coverId     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
